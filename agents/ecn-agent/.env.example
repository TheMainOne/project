SMARTSHEET_API_TOKEN=
ECN_PORT=4310
ECN_POLL_SECONDS=120
# true: assign ECN Number only when it is empty and Status is Initial Review.
ECN_AUTO_NUMBER=false

# Server-side manual AI review of one ECN.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Email of your Smartsheet account. Empty disables the follow-up queue.
ECN_FOLLOWUP_EMAIL=
ECN_FOLLOWUP_DAYS=7
# true checks new or changed eligible ECNs with OpenAI after a successful sync.
# false runs the same check from the Follow-up page. Sending always needs confirmation.
ECN_FOLLOWUP_AI_AUTO=false
